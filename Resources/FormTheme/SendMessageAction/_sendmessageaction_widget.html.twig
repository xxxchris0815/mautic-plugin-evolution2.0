{% block evolution_send_message_action_widget %}
    <div class="evolution-send-message-widget">
        <div class="form-group">
            {{ form_label(form.instance) }}
            {{ form_widget(form.instance, {'attr': {'class': 'form-control evolution-instance-select'}}) }}
            {{ form_errors(form.instance) }}
            <div class="help-block">
                <small>
                    <i class="fa fa-info-circle"></i>
                    {{ 'mautic.evolution.campaign.action.instance.help'|trans }}
                </small>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.message) }}
            {{ form_widget(form.message, {'attr': {'class': 'form-control', 'rows': 6}}) }}
            {{ form_errors(form.message) }}
            <div class="help-block">
                <small>
                    <i class="fa fa-info-circle"></i>
                    {{ 'mautic.evolution.campaign.action.message.content.help'|trans }}
                </small>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.phone_field) }}
            {{ form_widget(form.phone_field, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.phone_field) }}
        </div>

        <div class="form-group">
            {{ form_row(form.headers) }}
        </div>

        <div class="form-group">
            {{ form_row(form.data) }}
        </div>
    </div>
{% endblock %}
