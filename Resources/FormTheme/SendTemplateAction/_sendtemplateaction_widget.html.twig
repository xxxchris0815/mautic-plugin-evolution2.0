{% block evolution_send_template_action_widget %}
    <div class="evolution-send-template-widget" data-evolution-template-action="1">
        <div class="form-group">
            {{ form_label(form.instance) }}
            {{ form_widget(form.instance) }}
            {{ form_errors(form.instance) }}
            <div class="help-block">
                <small>
                    <i class="fa fa-info-circle"></i>
                    {{ 'mautic.evolution.campaign.action.instance.help'|trans }}
                </small>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.template) }}
            {{ form_widget(form.template) }}
            {{ form_errors(form.template) }}
            <div class="help-block">
                <small>
                    <i class="fa fa-info-circle"></i>
                    {{ 'mautic.evolution.campaign.action.template.select.help'|trans }}
                </small>
            </div>
        </div>

        <div class="form-group evolution-template-variables-group">
            {{ form_row(form.variables) }}
            <div class="help-block">
                <small>
                    <i class="fa fa-info-circle"></i>
                    {{ 'mautic.evolution.campaign.action.template.variables.help'|trans }}
                </small>
            </div>
            <div class="evolution-template-variable-hints alert alert-info" style="display:none;margin-top:8px;"></div>
        </div>

        <div class="form-group">
            {{ form_label(form.phone_field) }}
            {{ form_widget(form.phone_field, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.phone_field) }}
        </div>

        {{ form_row(form.template_catalog_json) }}

        <div class="form-group">
            {{ form_row(form.headers) }}
        </div>
    </div>
{% endblock %}
