{% extends '@MauticCore/FormTheme/form_simple.html.twig' %}

{% block mauticContent %}evolutionMetaTemplate{% endblock %}

{% block headerTitle %}
    {{ 'mautic.evolution.meta_template.new'|trans }}
{% endblock %}

{% block primaryFormContent %}
<div class="alert alert-info">
    {{ 'mautic.evolution.meta_template.form.intro'|trans }}
</div>

<div class="row">
    <div class="col-md-6">
        {{ form_row(form.name) }}
    </div>
    <div class="col-md-3">
        {{ form_row(form.language) }}
    </div>
    <div class="col-md-3">
        {{ form_row(form.category) }}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.allowCategoryChange) }}
    </div>
</div>

<hr>
<h4>{{ 'mautic.evolution.meta_template.section.header'|trans }}</h4>
<div class="row">
    <div class="col-md-4">
        {{ form_row(form.headerType) }}
    </div>
    <div class="col-md-8">
        {{ form_row(form.headerText) }}
        {{ form_row(form.headerExample) }}
        {{ form_row(form.headerMediaUrl) }}
    </div>
</div>

<hr>
<h4>{{ 'mautic.evolution.meta_template.section.body'|trans }}</h4>
<div class="row">
    <div class="col-md-12">
        {{ form_row(form.body) }}
        <p class="help-block">{{ 'mautic.evolution.meta_template.form.body.help'|trans }}</p>
        {{ form_row(form.exampleValues) }}
        <p class="help-block">{{ 'mautic.evolution.meta_template.form.examples.help'|trans }}</p>
        {{ form_row(form.footer) }}
    </div>
</div>

<hr>
<h4>{{ 'mautic.evolution.meta_template.section.buttons'|trans }}</h4>
<p class="help-block">{{ 'mautic.evolution.meta_template.form.buttons.help'|trans }}</p>
{% for i in 1..3 %}
<div class="panel panel-default js-meta-button-panel" data-button-index="{{ i }}">
    <div class="panel-heading">{{ 'mautic.evolution.meta_template.form.button_n'|trans({'%n%': i}) }}</div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3">
                {{ form_row(attribute(form, 'button' ~ i ~ 'Type')) }}
            </div>
            <div class="col-md-3">
                {{ form_row(attribute(form, 'button' ~ i ~ 'Text')) }}
            </div>
            <div class="col-md-3">
                {{ form_row(attribute(form, 'button' ~ i ~ 'Url')) }}
                {{ form_row(attribute(form, 'button' ~ i ~ 'UrlExample')) }}
            </div>
            <div class="col-md-3">
                {{ form_row(attribute(form, 'button' ~ i ~ 'Phone')) }}
            </div>
        </div>
    </div>
</div>
{% endfor %}

<hr>
<h4>{{ 'mautic.evolution.meta_template.section.mapping'|trans }}</h4>
<p class="help-block">{{ 'mautic.evolution.meta_template.form.mapping.help'|trans }}</p>
<div class="row">
    {% for i in 1..10 %}
        <div class="col-md-3">
            {{ form_row(attribute(form, 'paramField' ~ i)) }}
        </div>
    {% endfor %}
</div>
{% endblock %}

{% block rightFormContent %}
<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">{{ 'mautic.evolution.meta_template.help.title'|trans }}</h3>
    </div>
    <div class="panel-body">
        <p>{{ 'mautic.evolution.meta_template.help.body'|trans }}</p>
        <ul>
            <li>{{ 'mautic.evolution.meta_template.help.cloud'|trans }}</li>
            <li>{{ 'mautic.evolution.meta_template.help.approval'|trans }}</li>
            <li>{{ 'mautic.evolution.meta_template.help.variables'|trans }}</li>
        </ul>
        <a href="{{ path('mautic_evolution_meta_template_index') }}">
            {{ 'mautic.evolution.meta_template.back_to_list'|trans }}
        </a>
    </div>
</div>
<script>
(function () {
    var $ = window.mQuery || window.jQuery;
    if (!$) {
        return;
    }
    var toggleHeader = function () {
        var type = $('.js-meta-header-type').val();
        $('.js-meta-header-text').toggle(type === 'TEXT');
        $('.js-meta-header-media').toggle(type === 'IMAGE' || type === 'VIDEO' || type === 'DOCUMENT');
    };
    var toggleButtons = function () {
        $('.js-meta-button-type').each(function () {
            var type = $(this).val();
            var index = $(this).data('button-index');
            $('.js-meta-button-' + index + '.js-meta-button-text').toggle(type && type !== 'NONE');
            $('.js-meta-button-' + index + '.js-meta-button-url').toggle(type === 'URL');
            $('.js-meta-button-' + index + '.js-meta-button-phone').toggle(type === 'PHONE_NUMBER');
        });
    };
    $(document).on('change', '.js-meta-header-type', toggleHeader);
    $(document).on('change', '.js-meta-button-type', toggleButtons);
    toggleHeader();
    toggleButtons();
})();
</script>
{% endblock %}
